<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles/index.css">
  <link rel="stylesheet" href="/styles/auth.css">
  <link rel="stylesheet" href="/styles/form-errors.css">
  <title>ورود</title>
</head>

<body>
  <%- include("../components/header") %>
  <%- include("../components/dialogError") %>

  <section class="container auth">
    <div class="auth-card">

      <h2 class="auth-title">خوش آمدید</h2>
      <p class="auth-sub">برای ادامه وارد حساب خود شوید</p>

      <form class="auth-form" id="loginForm" action="/api/auth/login" method="POST">

        <div class="field">
          <label for="login-identifier">ایمیل یا نام کاربری</label>
          <input id="login-identifier" type="text" name="identifier" placeholder="example@mail.com یا username" autocomplete="username" required>
        </div>

        <div class="field">
          <label for="login-password">رمز عبور</label>
          <div class="password-wrap">
            <input id="login-password" type="password" name="password" placeholder="••••••••" autocomplete="current-password" required>
            <button type="button" class="toggle-pass" data-target="login-password" aria-label="نمایش رمز">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
        </div>

        <div class="auth-row">
          <label class="checkbox">
            <input type="checkbox" name="remember">
            <span>مرا به خاطر بسپار</span>
          </label>
          <a href="/auth/forgot-password" class="auth-link">فراموشی رمز؟</a>
        </div>

        <button type="submit" class="auth-btn">ورود</button>

        <p class="auth-foot">
          حساب نداری؟
          <a href="/auth/register" class="auth-link">ثبت نام کن</a>
        </p>
      </form>

    </div>
  </section>
</body>

<!-- <script src="/js/auth/login.js"></script> -->
<script src="/js/form-errors.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    FormKit.attach('#loginForm', {
      // --- اعتبارسنجی سمت کلاینت ---
      validate(values) {
        const errors = {};

        if (!values.identifier) {
          errors.identifier = 'ایمیل یا نام کاربری الزامی است';
        } else if (values.identifier.length < 3) {
          errors.identifier = 'حداقل ۳ کاراکتر وارد کنید';
        }

        if (!values.password) {
          errors.password = 'رمز عبور الزامی است';
        } else if (values.password.length < 6) {
          errors.password = 'رمز عبور باید حداقل ۶ کاراکتر باشد';
        }

        return errors;
      },

      // --- ارسال به سرور ---
      submit(values) {
        return FormKit.postJSON('/api/auth/login', {
          identifier: values.identifier,
          password: values.password,
          remember: !!values.remember,
        });
      },

      onSuccess() {
        location.href = '/';
      },
    });
  });
</script>

</html>